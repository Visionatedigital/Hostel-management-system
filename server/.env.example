# Server only. Copy to .env and supply your own key. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-4.1-mini

# Africa's Talking SMS: sandbox uses username sandbox and the simulator.
# Live sends bill your provider account. Use your live application username/key.
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
# Optional approved sender ID; never invent an unregistered sender.
AFRICASTALKING_SENDER_ID=
