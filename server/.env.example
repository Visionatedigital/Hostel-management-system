# Server only. Copy to .env and supply your own key. Never use VITE_ for secrets.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-4.1-mini

# EgoSMS: get API credentials from Settings > API Settings in the EgoSMS portal.
# Sandbox uses comms-test.pahappa.net; live sends are billable.
EGOSMS_ENVIRONMENT=sandbox
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
# Use a sender ID configured and approved in your EgoSMS account.
EGOSMS_SENDER_ID=EgoSMS
